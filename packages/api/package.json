{
  "name": "@ecom/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/generated/schema.d.ts",
    "generate:check": "node scripts/check-generated.mjs",
