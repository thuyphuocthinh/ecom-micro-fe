    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "openapi-typescript": "^7.9.1",
    "typescript": "~6.0.2",
    "vitest": "^3.2.4"
  }
}
