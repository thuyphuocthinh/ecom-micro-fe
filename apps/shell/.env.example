# Copy to .env.local to change a value; what is not set uses the default shown here.
# Where the micro-apps are served (the shell loads <url>/remoteEntry.js at runtime)
VITE_CATALOG_URL=http://localhost:3001
VITE_CHECKOUT_URL=http://localhost:3002
# The backend. In development the shell forwards /api to it (no CORS); in production put the
# frontend and /api behind one address instead
VITE_API_URL=http://localhost:4000
